[sub_resource type="Shader" id="Shader_ssdr1"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.stable's StandardMaterial3D.
// With added wind displacement.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;

// --- Original Uniforms ---
uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0, 0.001);
// uniform ivec2 albedo_texture_size; // Usually not needed unless doing specific texture size operations
uniform float point_size : hint_range(0.1, 128.0, 0.1); // For point rendering mode, might not be relevant for grass meshes

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform sampler2D texture_normal : hint_roughness_normal, filter_linear_mipmap, repeat_enable;
uniform float normal_scale : hint_range(-16.0, 16.0);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

// --- Wind Uniforms ---
// IMPORTANT: Assign a NoiseTexture2D resource to this uniform in the Godot Inspector!
uniform sampler2D wind_noise_texture : filter_linear_mipmap, repeat_enable;
uniform float wind_strength : hint_range(0.0, 2.0, 0.01) = 0.1; // How far the grass bends
uniform vec3 wind_direction = vec3(1.0, 0.0, 0.0); // Primary wind direction (will be normalized)
uniform float wind_speed : hint_range(0.0, 5.0, 0.01) = 0.5; // How fast the wind pattern moves
uniform float wind_noise_scale : hint_range(0.1, 10.0, 0.1) = 1.5; // Size of the wind gusts/waves
uniform float wind_bend_factor : hint_range(0.1, 5.0, 0.1) = 1.0; // Power applied to UV.y, controls how sharply the top bends (1=linear, >1 bends more at top)
uniform float wind_sway_speed_multiplier : hint_range(0.1, 5.0, 0.1) = 1.0; // Individual blade sway speed relative to overall wind speed

void vertex() {
	// --- Original UV calculation ---
	UV = UV * uv1_scale.xy + uv1_offset.xy;

	// --- Wind Calculation ---
	// Use a copy of the original vertex position for noise calculation
	vec3 world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;

	// Ensure direction is normalized (safer if user inputs non-normalized vector)
	// Add small offset to avoid normalizing zero vector if user inputs (0,0,0)
	vec3 normalized_wind_dir = normalize(wind_direction + vec3(0.00001, 0.0, 0.0));

	// Calculate UV coordinates for sampling the noise texture
	// Use world position (XZ plane) and time (TIME)
	// Animate noise lookup over time based on wind speed and direction
	// Adding world_pos.y slightly varies the animation vertically
	// Using two time components adds complexity to the movement
	float time_component_1 = TIME * wind_speed;
	float time_component_2 = TIME * wind_speed * wind_sway_speed_multiplier * 0.7; // Slightly different speed for more variation
	vec2 noise_uv = world_pos.xz * wind_noise_scale * 0.1; // Base spatial noise coord (scaled down)
	noise_uv += normalized_wind_dir.xz * time_component_1 * 0.1; // Move pattern along wind direction
	noise_uv += vec2(time_component_2 * 0.05, -time_component_2 * 0.03); // Add secondary swirling motion over time

	// Sample the noise texture (use .r channel for grayscale noise)
	float noise_value = texture(wind_noise_texture, noise_uv).r;

	// Remap noise from [0, 1] to [-1, 1] for back-and-forth sway
	float sway = (noise_value * 2.0) - 1.0;

	// Calculate bend amount based on vertical UV coordinate (0 at base, 1 at tip)
	// pow(UV.y, factor) makes the top bend more sharply. Ensure UV.y is clamped positive.
	float bend_amount = pow(max(0.0, UV.y), wind_bend_factor);

	// Calculate the final offset in world space
	// Apply sway along the normalized wind direction
	vec3 wind_offset_world = normalized_wind_dir * sway * wind_strength * bend_amount;

	// The offset needs to be applied in model space, so transform it back
	// Inverse MODEL_MATRIX might be expensive. A common approximation for direction vectors
	// (ignoring scale/shear) is to use the inverse transpose of the upper 3x3,
	// but simpler is often to just add the world offset directly if non-uniform scaling isn't extreme.
	// Let's try adding the world offset directly first, it often looks acceptable for wind.
	// For correctness with non-uniform scaling, transform offset back to model space:
	// vec3 wind_offset_model = (inverse(MODEL_MATRIX) * vec4(wind_offset_world, 0.0)).xyz;
	// VERTEX += wind_offset_model;

	// Simpler approach (add world offset directly to world position and transform back):
	// Calculate final world position
	vec3 final_world_pos = world_pos + wind_offset_world;
	// Transform final world position back to model space for VERTEX output
	VERTEX = (inverse(MODEL_MATRIX) * vec4(final_world_pos, 1.0)).xyz;

	// --- End Wind Calculation ---

	// If you experience issues with lighting/normals, you might need to recalculate NORMAL
	// based on the displaced vertex positions. This is complex and often omitted for simple effects.
	// Example (simplified, might need adjustment):
	// NORMAL = normalize((inverse(MODEL_MATRIX) * vec4(normalize(cross(dFdx(final_world_pos), dFdy(final_world_pos))), 0.0)).xyz);
}

void fragment() {
	vec2 base_uv = UV; // UV might have been modified by vertex shader, use the modified one.

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	float metallic_tex = dot(texture(texture_metallic, base_uv), metallic_texture_channel);
	METALLIC = metallic_tex * metallic;
	SPECULAR = specular;

	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	float roughness_tex = dot(texture(texture_roughness, base_uv), roughness_texture_channel);
	ROUGHNESS = roughness_tex * roughness;

	// Normal Map: Enabled (Applied after wind displacement)
	NORMAL_MAP = texture(texture_normal, base_uv).rgb;
	NORMAL_MAP_DEPTH = normal_scale;

	ALPHA *= albedo.a * albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
}"

